{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/saveOpenAiKey",
        "function": {
          "functionId": "saveOpenAiKey",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/askWhiteboardAssistant",
        "function": {
          "functionId": "askWhiteboardAssistant",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/getAiHistory",
        "function": {
          "functionId": "getAiHistory",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
