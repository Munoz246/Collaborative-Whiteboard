rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    // Basic auth guard used throughout the ruleset.
    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the parent whiteboard document so nested collections (items/chat/requests)
    // can reuse membership and role checks.
    function getWhiteboard(boardId) {
      return get(/databases/$(database)/documents/whiteboards/$(boardId));
    }

    // True when the signed-in user is part of whiteboard.members.
    function isMember(whiteboard) {
      return isSignedIn() && request.auth.uid in whiteboard.data.members;
    }

    // True when the signed-in user is listed as a moderator.
    function isMod(whiteboard) {
      return isSignedIn() && request.auth.uid in whiteboard.data.mods;
    }

    // True when the signed-in user is the whiteboard owner.
    function isOwner(whiteboard) {
      return isSignedIn() && request.auth.uid == whiteboard.data.owner;
    }

    // Convenience helper for privileged users.
    function isOwnerOrMod(whiteboard) {
      return isOwner(whiteboard) || isMod(whiteboard);
    }

    // Returns true if any provided keys are being modified
    function affectedAny(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Returns true if only the provided keys are being modified
    function affectedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Mods cannot demote other mods; they can only remove themselves.
    function validModEdit() {
      let removedMods = resource.data.mods.removeAll(request.resource.data.mods);
      return removedMods.size() == 0 || removedMods == [request.auth.uid];
    }

    function leavingWhiteboard(resource) {
      let removedMembers = resource.data.members.removeAll(request.resource.data.members);
      return removedMembers == [request.auth.uid];
    }

    function validItemType(itemType) {
      return itemType in ['rectangle', 'circle', 'triangle', 'rhombus', 'path', 'text', 'note', 'file'];
    }

    function validTransform(transform) {
      return transform is map
        && transform.keys().hasOnly(['x', 'y', 'width', 'height', 'rotation'])
        && transform.x is number
        && transform.y is number
        && transform.width is number
        && transform.height is number
        && transform.rotation is number
        && transform.width > 0
        && transform.height > 0;
    }

    function validColorField(value) {
      return value is string && value.size() > 0 && value.size() <= 32;
    }

    function validStrokeWidth(width) {
      return width is number && width >= 1 && width <= 64;
    }

    function validShapeKind(kind) {
      return kind in ['rectangle', 'circle', 'triangle', 'rhombus'];
    }

    function validShapeData(shapeData) {
      return shapeData is map
        && shapeData.keys().hasOnly(['shapeKind', 'shapeType', 'fill', 'stroke', 'strokeWidth'])
        && (
          ('shapeKind' in shapeData && shapeData.shapeKind is string && validShapeKind(shapeData.shapeKind))
          || ('shapeType' in shapeData && shapeData.shapeType is string && validShapeKind(shapeData.shapeType))
        )
        && (!('fill' in shapeData) || validColorField(shapeData.fill))
        && (!('stroke' in shapeData) || validColorField(shapeData.stroke))
        && (!('strokeWidth' in shapeData) || validStrokeWidth(shapeData.strokeWidth));
    }

    function validDrawingData(drawingData) {
      return drawingData is map
        && drawingData.keys().hasOnly(['color', 'strokeWidth', 'points', 'closed'])
        && (!('color' in drawingData) || validColorField(drawingData.color))
        && (!('strokeWidth' in drawingData) || validStrokeWidth(drawingData.strokeWidth))
        && (!('points' in drawingData) || drawingData.points is list)
        && (!('closed' in drawingData) || drawingData.closed is bool);
    }

    function validNoteData(noteData) {
      return noteData is map
        && noteData.keys().hasOnly(['text', 'color', 'fontSize', 'textAlign'])
        && (!('text' in noteData) || noteData.text is string)
        && (!('color' in noteData) || validColorField(noteData.color))
        && (!('fontSize' in noteData) || (noteData.fontSize is number && noteData.fontSize >= 8 && noteData.fontSize <= 400))
        && (!('textAlign' in noteData) || noteData.textAlign in ['left', 'center', 'right', 'justify']);
    }

    function validFileData(fileData) {
      return fileData is map
        && fileData.keys().hasOnly(['documentId', 'fileName', 'fileType'])
        && (!('documentId' in fileData) || fileData.documentId is string)
        && (!('fileName' in fileData) || fileData.fileName is string)
        && (!('fileType' in fileData) || fileData.fileType is string);
    }

    function validItemData(itemType, data) {
      return data is map
        && (
          (
            itemType in ['rectangle', 'circle', 'triangle', 'rhombus']
            && data.keys().hasOnly(['shape'])
            && ('shape' in data)
            && validShapeData(data.shape)
          )
          || (
            itemType == 'path'
            && data.keys().hasOnly(['drawing'])
            && ('drawing' in data)
            && validDrawingData(data.drawing)
          )
          || (
            itemType in ['text', 'note']
            && data.keys().hasOnly(['note'])
            && ('note' in data)
            && validNoteData(data.note)
          )
          || (
            itemType == 'file'
            && data.keys().hasOnly(['file'])
            && ('file' in data)
            && validFileData(data.file)
          )
        );
    }

    // ---------- Group chat (whiteboards/{boardId}/group-chat) ----------
    function groupChatBoard(boardId) {
      return getWhiteboard(boardId);
    }

    function validGroupChatCreate(boardId) {
      let wb = groupChatBoard(boardId);
      return isMember(wb)
        && request.resource.data.keys().hasOnly([
          'senderId', 'senderDisplayName', 'message', 'createdAt', 'updatedAt', 'edited', 'hidden'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderDisplayName is string
        && request.resource.data.senderDisplayName.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.edited == false
        && request.resource.data.hidden == false;
    }

    // Author edits their own visible message: text + server updatedAt (edited may already be true).
    function groupChatAuthorEdit(boardId) {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      let diffOk = diffKeys.hasOnly(['message', 'edited', 'updatedAt'])
        || diffKeys.hasOnly(['message', 'updatedAt']);
      return isMember(groupChatBoard(boardId))
        && resource.data.senderId == request.auth.uid
        && resource.data.hidden == false
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == resource.data.createdAt
        && diffOk
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.edited == true
        && request.resource.data.updatedAt == request.time;
    }

    // Author soft-retracts their own message (no hiddenBy).
    function groupChatAuthorRetract(boardId) {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isMember(groupChatBoard(boardId))
        && resource.data.senderId == request.auth.uid
        && resource.data.hidden == false
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.hidden == true
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.message == resource.data.message
        && request.resource.data.edited == resource.data.edited
        && diffKeys.hasOnly(['hidden', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // Owner/mod hides any message; records moderator uid in hiddenBy.
    function groupChatModHide(boardId) {
      let wb = groupChatBoard(boardId);
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isMember(wb)
        && isOwnerOrMod(wb)
        && resource.data.hidden == false
        && request.resource.data.hidden == true
        && request.resource.data.hiddenBy == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.edited == resource.data.edited
        && diffKeys.hasOnly(['hidden', 'hiddenBy', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // File manager rules: allows members to access shared files
    function isWhiteboardMember(boardId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/whiteboards/$(boardId)).data.members;
    }

    // ---------- User docs ----------
    // Profile document access: users can only read/write their own record.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Private nested user data (e.g. secrets/preferences) is also self-only.
    match /users/{userId}/private/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---------- Whiteboards ----------
    match /whiteboards/{boardId} {
      // Keep whiteboard metadata readable to signed-in users so invite links
      // can show board info and submit join requests.
      allow read: if isSignedIn();

      // Create is allowed for authenticated users, but they must set themselves owner.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/whiteboards/$(boardId))
        && request.resource.data.owner == request.auth.uid;

      // Owners can update anything. Mods can update except owner changes and mod-list
      // changes that demote other moderators.
      allow update: if isSignedIn() && (
        isOwner(resource) || (
          isMod(resource)
          && !affectedAny(['owner'])
          && (!affectedAny(['mods']) || validModEdit())
        ) || (
          isMember(resource)
          && affectedOnly(['members'])
          && leavingWhiteboard(resource)
        )
      );

      // Only owners can permanently remove a whiteboard.
      allow delete: if isSignedIn() && isOwner(resource);

      // Whiteboard canvas items (drawing, notes, shapes, files).
      match /items/{itemId} {
        // Members can load items in realtime.
        allow read: if isMember(getWhiteboard(boardId));

        // Item creation requires expected collaboration metadata and schema fields.
        allow create: if isMember(getWhiteboard(boardId))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.type is string
          && validItemType(request.resource.data.type)
          && validTransform(request.resource.data.transform)
          && validItemData(request.resource.data.type, request.resource.data.data)
          && request.resource.data.isLocked is bool;

        // Updates must preserve schema and always stamp updatedBy with the caller.
        // Locked items can only be changed by the locker (updatedBy) or owner/mod.
        allow update: if isMember(getWhiteboard(boardId))
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.type is string
          && validItemType(request.resource.data.type)
          && validTransform(request.resource.data.transform)
          && validItemData(request.resource.data.type, request.resource.data.data)
          && request.resource.data.isLocked is bool
          && (
            !resource.data.isLocked
            || resource.data.updatedBy == request.auth.uid
            || isOwnerOrMod(getWhiteboard(boardId))
          );

        // Same lock policy for deletes.
        allow delete: if isMember(getWhiteboard(boardId))
          && (
            !resource.data.isLocked
            || resource.data.updatedBy == request.auth.uid
            || isOwnerOrMod(getWhiteboard(boardId))
          );
      }

      // Requests from non-members who want to join a whiteboard.
      match /join-requests/{userId} {
        // Requesters can create their own join request.
        allow read: if isOwnerOrMod(getWhiteboard(boardId)) || (isSignedIn() && request.auth.uid == userId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        // Privileged users can clear requests; users can remove their own request.
        allow delete: if isOwnerOrMod(getWhiteboard(boardId)) || (isSignedIn() && request.auth.uid == userId);
      }

      // Optional membership subcollection support.
      match /members/{userId} {
        allow read: if isMember(getWhiteboard(boardId));
        allow write: if isOwnerOrMod(getWhiteboard(boardId));
      }

      // Per-board group chat; members read/write per rules below (no hard deletes).
      match /group-chat/{messageId} {
        allow read: if isMember(getWhiteboard(boardId));
        allow create: if validGroupChatCreate(boardId);
        allow update: if groupChatAuthorEdit(boardId)
          || groupChatAuthorRetract(boardId)
          || groupChatModHide(boardId);
        allow delete: if false;
      }
    }

    // Default-deny fallback for every path not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
